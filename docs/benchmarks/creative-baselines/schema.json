{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plein reproducible creative baseline",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "title",
    "brief",
    "aspectRatio",
    "trialShotId",
    "shots",
    "manualChecks",
    "measurement"
  ],
  "properties": {
    "format": {
      "const": "plein-creative-baseline"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "aspectRatio": {
      "enum": ["9:16", "16:9"]
    },
    "trialShotId": {
      "type": "string"
    },
    "shots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "no",
          "duration",
          "description",
          "imagePrompt",
          "motionPrompt",
          "dialogue"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "description": {
            "type": "string"
          },
          "imagePrompt": {
            "type": "string"
          },
          "motionPrompt": {
            "type": "string"
          },
          "dialogue": {
            "type": "array"
          }
        }
      }
    },
    "manualChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "runId",
        "firstShotComplete",
        "humanActions",
        "videoSubmits",
        "evidence",
        "quality"
      ],
      "properties": {
        "runId": {
          "type": ["string", "null"]
        },
        "firstShotComplete": {
          "type": ["boolean", "null"]
        },
        "humanActions": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "videoSubmits": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality": {
          "enum": ["pending-manual", "reviewed"]
        }
      }
    }
  }
}
