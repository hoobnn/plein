# Conventional Branch：https://conventionalbranch.org/
pattern='^(main|master|develop|(feature|feat|bugfix|fix|hotfix|release|chore|ai|copilot|cursor|claude|codex)/[a-z0-9]+(\.[a-z0-9]+)*(-[a-z0-9]+(\.[a-z0-9]+)*)*)$'
branch=$(git symbolic-ref --short HEAD)

# 允许维护 Dependabot 的自动更新分支；PR 上由 CI 核验机器人身份。
case "$branch" in dependabot/*) exit 0 ;; esac

if ! printf '%s' "$branch" | grep -qE "$pattern"; then
  echo "分支名 '$branch' 不符合 Conventional Branch 规范。" >&2
  echo "格式：<type>/<description>，例如 feature/add-login-page。" >&2
  echo "见 https://conventionalbranch.org/" >&2
  exit 1
fi

# 云端 CI 不再在推送 main 时运行，合并前检查在这里完成；急用可 git push --no-verify 跳过
pnpm verify

# 依赖有变动时再查漏洞（需要联网）
if git rev-parse -q --verify '@{u}' >/dev/null; then
  if git diff --name-only '@{u}' HEAD | grep -qE '(^|/)(package\.json|pnpm-lock\.yaml)$'; then
    pnpm audit:deps
  fi
fi
