{
  "name": "@plein/desktop",
  "productName": "plein",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack && electron . --dev",
    "start": "vp pack && electron .",
    "typecheck": "tsc -p .",
    "ffmpeg": "scripts/build-ffmpeg.sh",
    "stage:server": "vp pack && node scripts/stage-server.mjs && node scripts/fetch-font.mjs",
    "dist:mac": "pnpm stage:server && electron-builder --mac --publish never --config electron-builder.config.mjs"
  },
  "devDependencies": {
    "@plein/protocol": "workspace:*",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "author": "hoobnn",
  "description": "Plein 桌面端"
}
