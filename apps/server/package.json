{
  "name": "@plein/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "build": "vp pack",
    "start": "node --no-experimental-webstorage dist/main.mjs",
    "typecheck": "tsc -p .",
    "bench:migration": "tsx bench/migration.ts",
    "bench:stable-production": "tsx bench/stable-production.ts",
    "bench:recovery": "vp test run --config bench/vite.config.ts recovery.measure",
    "bench:recovery:real": "vp test run --config bench/vite.config.ts recovery-real",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts && vp fmt src/storage/migrations.gen.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.8",
    "@hono/node-server": "^2.1.5",
    "@hyperframes/player": "0.8.186",
    "@hyperframes/producer": "0.8.186",
    "@hyperframes/sdk": "0.8.186",
    "@plein/capabilities": "workspace:*",
    "@plein/doc": "workspace:*",
    "@plein/flow": "workspace:*",
    "@plein/nodes": "workspace:*",
    "@plein/plugin-sdk": "workspace:*",
    "@plein/protocol": "workspace:*",
    "@plein/providers": "workspace:*",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "gsap": "3.14.2",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "linkedom": "0.18.14",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "undici": "8.12.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "y-websocket": "^3.1.0"
  }
}
