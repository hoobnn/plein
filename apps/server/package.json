{
  "name": "@plein/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "build": "tsdown",
    "start": "node --no-experimental-webstorage dist/main.mjs",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts && biome format --write src/storage/migrations.gen.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@plein/capabilities": "workspace:*",
    "@plein/doc": "workspace:*",
    "@plein/flow": "workspace:*",
    "@plein/nodes": "workspace:*",
    "@plein/plugin-sdk": "workspace:*",
    "@plein/protocol": "workspace:*",
    "@plein/providers": "workspace:*",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lib0": "^0.2.119",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "y-websocket": "^3.1.0"
  }
}
