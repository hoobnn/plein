{
  "name": "plein",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @plein/server --filter @plein/web dev",
    "dev:server": "pnpm --filter @plein/server dev",
    "dev:web": "pnpm --filter @plein/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @plein/server start",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
