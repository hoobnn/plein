{
  "name": "plein",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @plein/server --filter @plein/web dev",
    "dev:server": "pnpm --filter @plein/server dev",
    "dev:web": "pnpm --filter @plein/web dev",
    "dev:desktop": "pnpm --filter @plein/desktop runtime:check && pnpm --parallel --filter @plein/web --filter @plein/desktop dev",
    "start:desktop": "pnpm --filter @plein/desktop runtime:check && pnpm --filter @plein/server --filter @plein/web build && pnpm --filter @plein/desktop start",
    "dist:desktop": "pnpm --filter @plein/web build && pnpm --filter @plein/desktop dist:mac",
    "build": "pnpm -r build",
    "start": "pnpm --filter @plein/server start",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "lint": "vp check && markdownlint '**/*.md' --ignore-path .gitignore",
    "audit:deps": "pnpm audit --audit-level=high",
    "format": "vp check --fix && markdownlint '**/*.md' --ignore-path .gitignore --fix",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e-lifecycle": "node --test e2e/server-lifecycle.contract.mjs",
    "prepare": "husky",
    "smoke": "pnpm --filter @plein/server exec tsx scripts/smoke.ts",
    "bench:migration": "pnpm --filter @plein/server bench:migration",
    "bench:recovery": "pnpm --filter @plein/server bench:recovery",
    "bench:e1": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.l4.config.ts e1-composition",
    "bench:rework": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.bench.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm --filter @plein/desktop test:profile && pnpm test:e2e-lifecycle && pnpm test:coverage && pnpm smoke",
    "e2e": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.config.ts",
    "e2e:file": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.config.ts",
    "e2e:grep": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.config.ts --grep",
    "e2e:core": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.config.ts --grep @core",
    "e2e:fail": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.config.ts --last-failed",
    "e2e:auth": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.auth.config.ts",
    "e2e:real": "node scripts/build-e2e-web.mjs && playwright test -c e2e/playwright.l4.config.ts",
    "perf": "pnpm --filter @plein/web exec vp build --mode e2e --outDir dist-e2e && pnpm --filter @plein/server exec node --import tsx ../../e2e/perf/bench.ts",
    "perf:compare": "pnpm --filter @plein/server exec node --import tsx ../../e2e/perf/compare.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "markdownlint-cli": "0.50.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
